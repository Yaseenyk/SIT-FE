# ─────────────────────────────────────────────────────────────────────────────
# AISA frontend — environment.
#
# Everything here is NEXT_PUBLIC_*, i.e. compiled into the JavaScript the browser
# downloads. Nothing secret can live in this file. The database credentials, the
# JWT signing key and the Cloudinary secret all belong in `be/.env`, on the server.
#
# Copy to `.env.local` for development.
# ─────────────────────────────────────────────────────────────────────────────

# Where the site is published. basePath and every canonical URL derive from it.
#   Project page:   https://<github-user>.github.io/aisa
#   Custom domain:  https://aisa.bsiet.edu.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The Spring Boot API. Must NOT end in a slash.
#   Local:      http://localhost:8080
#   Production: https://aisa-api.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
